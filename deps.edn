{:paths ["src"]
 ;; jp-go-dds (デジタル庁デザインシステム) -- the workspace's BASE design
 ;; system (root CLAUDE.md, 2026-08-05). `mealops.render-html` inlines
 ;; `jp-go-dds.skin/dds+skin` into the generated operator console so the
 ;; page has no external stylesheet fetch. Git coordinate (not
 ;; :local/root) so the render-html build also works in a standalone fork
 ;; outside the monorepo checkout -- the same coordinate the sibling
 ;; cook-chill/confectionery actors (isic-1071/1073) already pin.
 :deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 ;; NOTE: `:override-deps` only re-points coordinates for libs ALREADY in
 ;; the dependency graph. Neither langgraph nor langchain is in `:deps`,
 ;; so this alias is inert today -- it is kept as the documented seam for
 ;; when `mealops.advisor` grows a real StateGraph. `mealops.operation` is
 ;; a plain function, NOT a compiled graph, so nothing in this repo calls
 ;; `langgraph.graph/run*`; see `mealops.render-html`'s "Disclosed gaps".
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  :run {:main-opts ["-m" "mealops.sim"]}
  ;; clojure -M:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the REAL actor stack
  ;; (mealops.operation -> mealops.governor -> mealops.store). THROWS if
  ;; the run produces no HARD governor hold, or fewer distinct HARD rules
  ;; than the evidence floor -- see mealops.render-html.
  :render-html {:main-opts ["-m" "mealops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
